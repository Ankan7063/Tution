# Copy to server/.env and fill in real values. Never commit the filled-in file.

# MongoDB Atlas SRV connection string for the "Tution" database.
# In the Atlas cluster: Network Access -> add your IP (Render needs the 0.0.0.0/0
# entry or Render's egress ranges), then use the "Connect / Drivers" string.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/"
MONGODB_DB="Tution"

# API port. Render injects PORT automatically; 5001 matches client/vite.config.js.
PORT=5001

# Sign JWTs with a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Origin of the frontend, used for CORS. On Vercel this is your *.vercel.app URL.
CLIENT_URL=http://localhost:5173

# Optional: only needed for outbound email notifications. Leave blank to skip email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
